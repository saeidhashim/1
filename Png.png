" alt="JCreator">
  <div class="menu-bar-cover" id="menuBarCover"></div>
</div>
<div class="toast" id="toast"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M5 12 l4 4 l10-10"/></svg><span>Copied to clipboard</span></div>
<script>
const programs = [
{
  ex:'01',
  title:'STRING EXTRACTION',
  aim:'To write a Java application to extract a portion of a character string and print the extracted string.',
  algo:['Start the program.','Import the java.util.Scanner class and create a Scanner object to read input from the keyboard.','Read the input string str using nextLine().','Read the starting position start and the ending position end using nextInt().','Extract the required portion using str.substring(start, end) and store it in result.','Display the extracted string.','Stop the program.'],
  program:`import java.util.Scanner;

class StringExtract
{
    public static void main(String args[])
    {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a string: ");
        String str = sc.nextLine();

        System.out.print("Enter starting position: ");
        int start = sc.nextInt();

        System.out.print("Enter ending position: ");
        int end = sc.nextInt();

        String result = str.substring(start, end);
        System.out.println("Extracted string: " + result);
    }
}`,
  output:`Enter a string: Hello World Program
Enter starting position: 6
Enter ending position: 11
Extracted string: World`
},
{
  ex:'02',
  title:'MULTIPLE INHERITANCE USING INTERFACES',
  aim:'To write a Java program to implement the concept of multiple inheritance using interfaces.',
  algo:['Start the program.','Declare an interface Father with the abstract method fatherQuality().','Declare an interface Mother with the abstract method motherQuality().','Create a class Child that implements both Father and Mother and defines all their methods. Also add its own method childQuality().','In the main() method of the class MultipleInheritance, create an object of the class Child.','Call fatherQuality(), motherQuality() and childQuality() using the object.','Display the output and stop the program.'],
  program:`import java.util.*;

interface Father {
    void fatherQuality();
}

interface Mother {
    void motherQuality();
}

class Child implements Father, Mother {
    public void fatherQuality() {
        System.out.println("Child inherits qualities from Father.");
    }
    public void motherQuality() {
        System.out.println("Child inherits qualities from Mother.");
    }
    public void childQuality() {
        System.out.println("Child has its own qualities.");
    }
}

public class MultipleInheritance {
    public static void main(String[] args) {
        Child obj = new Child();
        obj.fatherQuality();
        obj.motherQuality();
        obj.childQuality();
    }
}`,
  output:`Child inherits qualities from Father.
Child inherits qualities from Mother.
Child has its own qualities.`
},
{
  ex:'03',
  title:'USER-DEFINED EXCEPTION (PAYOUT-OF-BOUNDS)',
  aim:'To write a Java program to create an exception called payout-of-bounds and throw the exception.',
  algo:['Start the program.','Create a user-defined exception class payout_of_bounds by extending the Exception class.','Define a method checkpay(pay, paylimit) that declares throws payout_of_bounds.','Inside checkpay(), if pay is greater than paylimit, throw the exception using throw new payout_of_bounds(pay); otherwise print "Payout approved".','In main(), read the pay limit and the pay from the user.','Call checkpay() inside a try block.','Handle the exception in the catch block and display the exception message.','Stop the program.'],
  program:`import java.util.Scanner;

class payout_of_bounds extends Exception {
    public payout_of_bounds(int pay) {
        super();
    }
}

public class PayoutOutOfBounds
{
    static void checkpay(int pay, int paylimit) throws payout_of_bounds
    {
        if (pay > paylimit)
            throw new payout_of_bounds(pay);
        else
            System.out.println("Payout approved");
    }

    public static void main(String args[])
    {
        try
        {
            Scanner in = new Scanner(System.in);
            System.out.print("Enter Pay Limit: ");
            int paylimit = in.nextInt();
            System.out.print("Enter Pay: ");
            int pay = in.nextInt();
            checkpay(pay, paylimit);
        }
        catch (payout_of_bounds pob)
        {
            System.out.println("Caught the Exception");
            System.out.println("Exception occurred: " + pob);
        }
    }
}`,
  output:`Run 1 (pay within the limit)
Enter Pay Limit: 5000
Enter Pay: 3000
Payout approved

Run 2 (pay exceeds the limit - exception thrown)
Enter Pay Limit: 5000
Enter Pay: 7500
Caught the Exception
Exception occurred: payout_of_bounds`
},
{
  ex:'04',
  title:'MULTITHREADING WITH PRIORITIES',
  aim:'To write a Java program to implement the concept of multithreading with the use of any three multiplication tables and assign three different priorities to them.',
  algo:['Start the program.','Create a class TableThread that extends the Thread class and stores a number.','Override the run() method to print the multiplication table (1 to 10) of that number, pausing 500 ms after each line using Thread.sleep(500).','In main(), create three thread objects for the tables of 2, 5 and 10.','Set the thread names as Thread-1, Thread-2 and Thread-3.','Assign priorities: MIN_PRIORITY (1) to Thread-1, NORM_PRIORITY (5) to Thread-2 and MAX_PRIORITY (10) to Thread-3.','Display the priority of each thread using getPriority().','Start all three threads and stop the program.'],
  program:`class TableThread extends Thread {
    int number;
    TableThread(int number) {
        this.number = number;
    }
    public void run() {
        System.out.println("\\nMultiplication Table of " + number);
        for (int i = 1; i <= 10; i++) {
            System.out.println(
                Thread.currentThread().getName() +
                " : " + number + " x " + i + " = " + (number * i)
            );
            try {
                Thread.sleep(500);
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }
    }
}

public class MultiThreadTable {
    public static void main(String[] args) {
        TableThread t1 = new TableThread(2);
        TableThread t2 = new TableThread(5);
        TableThread t3 = new TableThread(10);

        t1.setName("Thread-1");
        t2.setName("Thread-2");
        t3.setName("Thread-3");

        t1.setPriority(Thread.MIN_PRIORITY);
        t2.setPriority(Thread.NORM_PRIORITY);
        t3.setPriority(Thread.MAX_PRIORITY);

        System.out.println("Thread-1 Priority : " + t1.getPriority());
        System.out.println("Thread-2 Priority : " + t2.getPriority());
        System.out.println("Thread-3 Priority : " + t3.getPriority());

        t1.start();
        t2.start();
        t3.start();
    }
}`,
  output:`Thread-1 Priority : 1
Thread-2 Priority : 5
Thread-3 Priority : 10

Multiplication Table of 2
Thread-1 : 2 x 1 = 2
Multiplication Table of 5
Thread-2 : 5 x 1 = 5
Multiplication Table of 10
Thread-3 : 10 x 1 = 10
Thread-1 : 2 x 2 = 4
Thread-2 : 5 x 2 = 10
Thread-3 : 10 x 2 = 20
... (continues up to x 10)
Thread-1 : 2 x 10 = 20
Thread-2 : 5 x 10 = 50
Thread-3 : 10 x 10 = 100

Note: the order may vary from run to run.`
},
{
  ex:'05',
  title:'DRAWING SHAPES USING AWT',
  aim:'To write a Java program to draw several shapes in the created window.',
  algo:['Start the program.','Import the java.awt and java.awt.event packages.','Create a class DrawShapes that extends Frame.','In the constructor, set the title and size of the window and make it visible.','Add a WindowListener (WindowAdapter) so that the program exits when the window is closed.','Override the paint(Graphics g) method and draw the shapes using drawLine(), drawRect(), fillRect(), drawOval(), drawArc() and drawPolygon(); label each with drawString().','In main(), create an object of DrawShapes to display the window.','Stop the program.'],
  program:`import java.awt.*;
import java.awt.event.*;

public class DrawShapes extends Frame
{
    DrawShapes()
    {
        setTitle("Drawing Shapes");
        setSize(600, 500);
        setVisible(true);
        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent we) {
                System.exit(0);
            }
        });
    }

    public void paint(Graphics g) {
        g.drawLine(50, 80, 200, 80);
        g.drawString("Line", 100, 70);

        g.drawRect(50, 120, 120, 80);
        g.drawString("Rectangle", 70, 220);

        g.fillRect(220, 120, 120, 80);
        g.drawString("Filled Rectangle", 220, 220);

        g.drawOval(50, 260, 120, 80);
        g.drawString("Oval", 90, 360);

        g.drawOval(220, 260, 100, 100);
        g.drawString("Circle", 240, 380);

        g.drawArc(380, 120, 120, 80, 0, 180);
        g.drawString("Arc", 420, 220);

        int x[] = {400, 350, 450};
        int y[] = {300, 400, 400};
        g.drawPolygon(x, y, 3);
        g.drawString("Triangle", 390, 420);
    }

    public static void main(String args[]) {
        new DrawShapes();
    }
}`,
  output:`A window appears showing:
 - Line, Rectangle, Filled Rectangle
 - Oval, Circle, Arc and Triangle drawn with labels.`
},
{
  ex:'06',
  title:'MULTIPLE SELECTION LIST BOX',
  aim:'To write a Java program to demonstrate the Multiple Selection List-box.',
  algo:['Start the program.','Import the java.awt and java.awt.event packages.','Create a class MultipleSelectionList that extends Frame and implements ActionListener.','Create a List with multiple selection enabled using new List(6, true) and add the items Java, Python, C, C++, JavaScript and PHP.','Create a Button ("Show Selection") and a Label to display the result; add all components to the frame using FlowLayout.','Register the button with an ActionListener.','In actionPerformed(), get the selected items using getSelectedItems(), join them into a string and show it in the label.','Add a window-closing event to exit the program and make the frame visible.'],
  program:`import java.awt.*;
import java.awt.event.*;

public class MultipleSelectionList extends Frame implements ActionListener {
    List list;
    Button btn;
    Label lbl;

    MultipleSelectionList() {
        setTitle("Multiple Selection List Box");
        setSize(400, 300);
        setLayout(new FlowLayout());

        list = new List(6, true);
        list.add("Java");
        list.add("Python");
        list.add("C");
        list.add("C++");
        list.add("JavaScript");
        list.add("PHP");

        btn = new Button("Show Selection");
        lbl = new Label("Selected Items: ");

        add(list);
        add(btn);
        add(lbl);

        btn.addActionListener(this);
        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent we) {
                System.exit(0);
            }
        });
        setVisible(true);
    }

    public void actionPerformed(ActionEvent ae) {
        String items[] = list.getSelectedItems();
        String result = "Selected Items: ";
        for (String item : items) {
            result += item + " ";
        }
        lbl.setText(result);
    }

    public static void main(String args[]) {
        new MultipleSelectionList();
    }
}`,
  output:`Window displays a list with Java, Python, C, C++, JavaScript, PHP (multiple selection enabled).
When items are selected and "Show Selection" is clicked:
Selected Items: Java C++ PHP   (example)`
},
{
  ex:'07',
  title:'FRAME WITH TEXT FIELDS AND TEXT AREA',
  aim:'To write a Java program to create a frame with three text fields for name, age and qualification and a text field for multiple lines for address.',
  algo:['Start the program.','Import the java.awt and java.awt.event packages.','Create a class StudentDetails that extends Frame.','Declare four Labels (Name, Age, Qualification, Address), three TextFields and one TextArea (for the multi-line address).','Set the layout to null and place every component at the required position using setBounds(x, y, width, height).','Add all the components to the frame.','Add a window-closing event to exit the program and make the frame visible.','In main(), create an object of StudentDetails.'],
  program:`import java.awt.*;
import java.awt.event.*;

public class StudentDetails extends Frame {
    Label l1, l2, l3, l4;
    TextField t1, t2, t3;
    TextArea ta;

    StudentDetails() {
        setTitle("Student Details");
        setSize(450, 350);
        setLayout(null);

        l1 = new Label("Name");
        l2 = new Label("Age");
        l3 = new Label("Qualification");
        l4 = new Label("Address");

        t1 = new TextField();
        t2 = new TextField();
        t3 = new TextField();
        ta = new TextArea();

        l1.setBounds(50, 50, 100, 20);
        t1.setBounds(170, 50, 180, 25);
        l2.setBounds(50, 90, 100, 20);
        t2.setBounds(170, 90, 180, 25);
        l3.setBounds(50, 130, 100, 20);
        t3.setBounds(170, 130, 180, 25);
        l4.setBounds(50, 170, 100, 20);
        ta.setBounds(170, 170, 180, 80);

        add(l1); add(t1);
        add(l2); add(t2);
        add(l3); add(t3);
        add(l4); add(ta);

        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent we) {
                System.exit(0);
            }
        });
        setVisible(true);
    }

    public static void main(String args[]) {
        new StudentDetails();
    }
}`,
  output:`A window titled "Student Details" appears with labels and text fields for Name, Age, Qualification and a TextArea for Address arranged vertically.`
},
{
  ex:'08',
  title:'MENU BAR AND PULL-DOWN MENUS',
  aim:'To write a Java program to create a menu bar and pull-down menus.',
  algo:['Start the program.','Import the java.awt and java.awt.event packages.','Create a class MenuBarExample that extends Frame and implements ActionListener.','Create a MenuBar and the menus File, Edit and Help.','Create the menu items (New, Open, Save, Exit, Cut, Copy, Paste, About) and add them to their respective menus; add a separator before Exit.','Add the menus to the menu bar and attach the menu bar to the frame using setMenuBar().','Register an ActionListener for every menu item.','In actionPerformed(), get the command using getActionCommand(); exit the program if it is "Exit", otherwise print the name of the selected menu item.'],
  program:`import java.awt.*;
import java.awt.event.*;

public class MenuBarExample extends Frame implements ActionListener {
    MenuBar mb;
    Menu file, edit, help;
    MenuItem newItem, openItem, saveItem, exitItem;
    MenuItem cutItem, copyItem, pasteItem;
    MenuItem aboutItem;

    MenuBarExample() {
        setTitle("Menu Bar Example");
        setSize(400, 300);

        mb = new MenuBar();
        file = new Menu("File");
        edit = new Menu("Edit");
        help = new Menu("Help");

        newItem = new MenuItem("New");
        openItem = new MenuItem("Open");
        saveItem = new MenuItem("Save");
        exitItem = new MenuItem("Exit");

        cutItem = new MenuItem("Cut");
        copyItem = new MenuItem("Copy");
        pasteItem = new MenuItem("Paste");
        aboutItem = new MenuItem("About");

        file.add(newItem);
        file.add(openItem);
        file.add(saveItem);
        file.addSeparator();
        file.add(exitItem);

        edit.add(cutItem);
        edit.add(copyItem);
        edit.add(pasteItem);
        help.add(aboutItem);

        mb.add(file);
        mb.add(edit);
        mb.add(help);
        setMenuBar(mb);

        newItem.addActionListener(this);
        openItem.addActionListener(this);
        saveItem.addActionListener(this);
        exitItem.addActionListener(this);
        cutItem.addActionListener(this);
        copyItem.addActionListener(this);
        pasteItem.addActionListener(this);
        aboutItem.addActionListener(this);

        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent we) {
                System.exit(0);
            }
        });
        setVisible(true);
    }

    public void actionPerformed(ActionEvent ae) {
        String command = ae.getActionCommand();
        if (command.equals("Exit")) {
            System.exit(0);
        } else {
            System.out.println(command + " Menu Selected");
        }
    }

    public static void main(String args[]) {
        new MenuBarExample();
    }
}`,
  output:`A window with a menu bar appears: File (New, Open, Save, Exit), Edit (Cut, Copy, Paste), Help (About).

Console output when menu items are selected:
New Menu Selected
Cut Menu Selected
About Menu Selected
(Selecting Exit closes the program.)`
},
{
  ex:'09',
  title:'RESPONDING TO MOUSE CLICKS',
  aim:'To write a Java program to respond to mouse clicks.',
  algo:['Start the program.','Import the java.awt and java.awt.event packages.','Create a class MouseClickExample that extends Frame and implements the MouseListener interface.','Declare a String message with the initial text "Click anywhere inside the frame".','In the constructor, set the title and size, register the mouse listener using addMouseListener(this), add the window-closing event and make the frame visible.','Override paint() to display the message using drawString().','In mouseClicked(), read the click position using getX() and getY(), store it in message and call repaint().','Define the remaining MouseListener methods (pressed, released, entered, exited) with empty bodies.','Stop the program.'],
  program:`import java.awt.*;
import java.awt.event.*;

public class MouseClickExample extends Frame implements MouseListener {
    String message = "Click anywhere inside the frame";

    MouseClickExample() {
        setTitle("Mouse Click Example");
        setSize(500, 300);
        addMouseListener(this);
        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent we) {
                System.exit(0);
            }
        });
        setVisible(true);
    }

    public void paint(Graphics g) {
        g.drawString(message, 100, 150);
    }

    public void mouseClicked(MouseEvent me) {
        message = "Mouse Clicked at X = " + me.getX() +
                   ", Y = " + me.getY();
        repaint();
    }

    public void mousePressed(MouseEvent me) { }
    public void mouseReleased(MouseEvent me) { }
    public void mouseEntered(MouseEvent me) { }
    public void mouseExited(MouseEvent me) { }

    public static void main(String args[]) {
        new MouseClickExample();
    }
}`,
  output:`Initially the frame shows: "Click anywhere inside the frame"
After clicking at (150, 120):
Mouse Clicked at X = 150, Y = 120  (coordinates vary with click position)`
},
{
  ex:'10',
  title:'DRAWING SHAPES ON MOUSE CLICK',
  aim:'To write a Java program to draw a circle, square, ellipse and rectangle at the mouse click position.',
  algo:['Start the program.','Import the java.awt and java.awt.event packages.','Create a class MouseShapes that extends Frame and implements MouseListener.','Declare the variables x, y (click position) and shape (shape number, initially 0).','In the constructor, set the title and size, register the mouse listener, add the window-closing event and make the frame visible.','In mouseClicked(), store the click position in x and y, increase shape by 1 (reset to 1 after 4) and call repaint().','In paint(), use a switch on shape: 1 = circle (drawOval 60x60), 2 = square (drawRect 60x60), 3 = ellipse (drawOval 100x60), 4 = rectangle (drawRect 100x60), drawn at (x, y).','Define the remaining MouseListener methods with empty bodies.'],
  program:`import java.awt.*;
import java.awt.event.*;

public class MouseShapes extends Frame implements MouseListener {
    int x = 0, y = 0;
    int shape = 0;

    MouseShapes() {
        setTitle("Draw Shapes on Mouse Click");
        setSize(600, 500);
        addMouseListener(this);
        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent we) {
                System.exit(0);
            }
        });
        setVisible(true);
    }

    public void paint(Graphics g) {
        switch(shape) {
            case 1:
                g.drawOval(x, y, 60, 60);
                break;
            case 2:
                g.drawRect(x, y, 60, 60);
                break;
            case 3:
                g.drawOval(x, y, 100, 60);
                break;
            case 4:
                g.drawRect(x, y, 100, 60);
                break;
        }
    }

    public void mouseClicked(MouseEvent me) {
        x = me.getX();
        y = me.getY();
        shape++;
        if(shape > 4)
            shape = 1;
        repaint();
    }

    public void mousePressed(MouseEvent me) { }
    public void mouseReleased(MouseEvent me) { }
    public void mouseEntered(MouseEvent me) { }
    public void mouseExited(MouseEvent me) { }

    public static void main(String args[]) {
        new MouseShapes();
    }
}`,
  output:`- 1st click: draws a circle (60x60) at the click position
- 2nd click: draws a square (60x60)
- 3rd click: draws an ellipse (100x60)
- 4th click: draws a rectangle (100x60)
- 5th click onwards: cycle repeats from circle.`
}
];
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function buildMenu(){
  const layer=document.getElementById('menuBarCover');
  const menuLabels = ["File","Edit","View","Project","Build","Run","Tools","Configure","Window","Help"];
  menuLabels.forEach((label,i)=>{
    const prog=programs[i];
    const item=document.createElement('div');
    item.className='menu-link';
    item.tabIndex=0;
    item.setAttribute('aria-label', label);
    item.innerHTML=`${esc(label)}<div class="popup" role="dialog">
        <div class="popup-inner">
          <div class="popup-header">
            <div style="flex:1">
              <div class="ex-badge">EX . ${prog.ex} <span>// JAVA LAB 2026-27</span></div>
              <div class="popup-title">${esc(prog.title)}</div>
              <div class="popup-sub">${esc(prog.aim)}</div>
            </div>
            <button class="icon-btn" data-copy-all="${i}" title="Copy program"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0f2a52" stroke-width="1.8"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9 V7 a2 2 0 0 0-2-2 H5 a2 2 0 0 0-2 2 v8 a2 2 0 0 0 2 2 h2"/></svg></button>
          </div>
          <div class="tab-bar" data-tabs="${i}">
            <button class="tab-chip active" data-tab="program">Program</button>
            <button class="tab-chip" data-tab="algorithm">Algorithm</button>
            <button class="tab-chip" data-tab="output">Output</button>
            <button class="copy-all" data-copy-current="${i}">Copy</button>
          </div>
          <div class="panel active" data-panel="program">
            <div class="code-wrap">
              <div class="code-top"><span class="code-label"><i></i> Ex${prog.ex}.java</span><button class="copy-mini" data-copy="program-${i}">Copy program</button></div>
              <pre class="code-block">${esc(prog.program)}</pre>
            </div>
          </div>
          <div class="panel" data-panel="algorithm">
            <div class="algorithm"><ol>${prog.algo.map(s=>`<li>${esc(s)}</li>`).join('\n')}</ol></div>
            <div style="display:flex;justify-content:flex-end;margin-top:10px"><button class="copy-mini" data-copy="algo-${i}" style="background:#0f2a52;color:#fff;border-color:#0f2a52">Copy algorithm</button></div>
          </div>
          <div class="panel" data-panel="output">
            <div class="result-box">
              <div class="result-head"><b>Output / Result</b><button class="copy-mini" data-copy="output-${i}">Copy output</button></div>
              <pre class="result-pre">${esc(prog.output)}</pre>
            </div>
          </div>
        </div>
      </div>`;
    layer.appendChild(item);
  });
  layer.addEventListener('click', e=>{
    const chip=e.target.closest('.tab-chip');
    if(chip){
      const bar=chip.closest('.tab-bar');
      bar.querySelectorAll('.tab-chip').forEach(c=>c.classList.toggle('active',c===chip));
      const popup=bar.closest('.popup');
      const tab=chip.dataset.tab;
      popup.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.dataset.panel===tab));
      e.stopPropagation();
    }
    const cp=e.target.closest('[data-copy]');
    if(cp){
      const id=cp.dataset.copy;
      let t='';
      if(id.startsWith('program-')) t=programs[id.split('-')[1]].program;
      else if(id.startsWith('algo-')) t=programs[id.split('-')[1]].algo.map((s,idx)=>`${idx+1}. ${s}`).join('\n');
      else if(id.startsWith('output-')) t=programs[id.split('-')[1]].output;
      copy(t); e.stopPropagation();
    }
    const ca=e.target.closest('[data-copy-all]');
    if(ca){ copy(programs[ca.dataset.copyAll].program); e.stopPropagation(); }
    const cc=e.target.closest('[data-copy-current]');
    if(cc){
      const i=cc.dataset.copyCurrent;
      const popup=cc.closest('.popup');
      const active=popup.querySelector('.panel.active');
      let t='';
      if(active.dataset.panel==='program') t=programs[i].program;
      else if(active.dataset.panel==='algorithm') t=programs[i].algo.map((s,idx)=>`${idx+1}. ${s}`).join('\n');
      else t=programs[i].output;
      copy(t); e.stopPropagation();
    }
  });
}
function copy(t){navigator.clipboard.writeText(t).then(()=>toast())}
function toast(){
  const el=document.getElementById('toast');
  el.classList.add('show');
  clearTimeout(toast._t);
  toast._t=setTimeout(()=>el.classList.remove('show'),1600);
}
buildMenu();
document.addEventListener('keydown', (e)=>{
  if(e.code==='Space' && !e.target.matches('input,textarea,pre')){
    if(e.target.closest('.code-block, .result-pre')) return;
    e.preventDefault();
    const elem=document.getElementById('appWindow');
    if(!document.fullscreenElement){
      (elem.requestFullscreen||elem.webkitRequestFullscreen||function(){}).call(elem);
    }else{
      (document.exitFullscreen||document.webkitExitFullscreen||function(){}).call(document);
    }
  }
});
document.getElementById('appWindow').addEventListener('dblclick',()=>{
  const elem=document.getElementById('appWindow');
  if(!document.fullscreenElement) elem.requestFullscreen().catch(()=>{});
  else document.exitFullscreen().catch(()=>{});
});
</script>
